---
/**
 * Trame de points (charte v2, planche 13) :
 * le point est le motif de la marque (avec les cercles concentriques). Gros et blanc pour dessiner, petit et bleu pour la trame.
 * "h" : dessine un H (colonnes extrêmes + ligne centrale) comme dans le logo.
 * "field" : trame régulière de petits points bleus uniquement.
 */
interface Props {
  variant?: "h" | "field";
  cols?: number;
  rows?: number;
  class?: string;
}
const { variant = "h", cols = 6, rows = 5, class: className = "" } = Astro.props;
const step = 36;
const big = 7.5;
const small = 4.5; // 0,6 × le gros point (charte)
const mid = Math.floor(rows / 2);
const dots = [];
for (let r = 0; r < rows; r++) {
  for (let c = 0; c < cols; c++) {
    const isBig = variant === "h" && (c === 0 || c === cols - 1 || r === mid);
    dots.push({ x: c * step + big, y: r * step + big, big: isBig, d: (r + c) * 70 });
  }
}
const w = (cols - 1) * step + big * 2;
const h = (rows - 1) * step + big * 2;
---

<svg
  viewBox={`0 0 ${w} ${h}`}
  width={w}
  height={h}
  class={`dg ${className}`}
  aria-hidden="true"
  focusable="false"
>
  {dots.map((d) => (
    <circle cx={d.x} cy={d.y} r={d.big ? big : small} fill={d.big ? "#EAF3EE" : "#2D5083"} class={d.big ? "dot-big" : "dot-small"} style={`--d:${d.d}ms`} />
  ))}
</svg>
