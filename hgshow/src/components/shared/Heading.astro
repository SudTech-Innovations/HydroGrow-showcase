---
// Base props that are common to all variants
interface Props {
  level?: 1 | 2 | 3 | 4 | 5 | 6;
  size?: 1 | 2 | 3 | 4 | 5 | 6;
  text?: string;
  class?: string;
  [key: string]: any;
}

const { level = 1, size, text, class: className = "", ...rest } = Astro.props;

// Runtime check to ensure proper usage
const hasSlotContent = Astro.slots.has("default");
if (text && hasSlotContent) {
  throw new Error('Heading component: Cannot use both "text" prop and slot content. Use either text prop or slot, not both.');
}

// Default heading styles based on level/size
const levelStyles = {
  1: "text-[40px] leading-[44px] font-normal sm:text-[56px] sm:leading-[58px]",
  2: "text-[28px] leading-[32px] font-normal sm:text-[32px] sm:leading-[36px]",
  3: "text-[22px] leading-[26px] font-normal",
  4: "text-xl leading-[24px] font-normal",
  5: "text-lg leading-[22px] font-normal",
  6: "text-base leading-[22px] font-normal",
};

// Use size prop if provided, otherwise fall back to level
const styleLevel = size || level;
const classes = `${levelStyles[styleLevel]} ${className}`;

// Dynamic component based on level (semantic level, not visual size)
const Tag = `h${level}` as any;
---

<Tag class={classes} {...rest}>
  {
    text ? (
      text
    ) : (
      <slot />
    )
  }
</Tag>
