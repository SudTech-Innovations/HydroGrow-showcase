---
import type { CollectionEntry } from "astro:content";
import PostSummary from "../../components/blog/summary.astro";
import DotGrid from "../shared/DotGrid.astro";
import SimpleHero from "../global/simple-hero/simple-hero.astro";

// Define TypeScript interfaces
interface Page {
  title: string;
  description?: string;
  [key: string]: any; // Allow additional properties
}

interface Props {
  page: Page;
  posts: CollectionEntry<"blog">[];
  badge?: string;
}

// Receive props
const { page, posts, badge } = Astro.props satisfies Props;
---

<SimpleHero title={page.title} description={page.description || ""} badge={badge} />

<section class="relative isolate py-16 overflow-hidden">
  <DotGrid variant="field" cols={12} rows={6} class="hidden lg:block absolute -z-10 -right-10 top-4 w-[420px] opacity-60" />
  <div class="max-w-7xl mx-auto px-6 lg:px-14">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 items-stretch">
      {posts && posts.map((post) => <PostSummary post={post} />)}
    </div>
  </div>
</section>
