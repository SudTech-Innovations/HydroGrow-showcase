---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

// Receive props
const { post } = Astro.props;
const {
  data: { thumb_image, tags, title },
  slug,
} = post;
---

<article
  class="group bg-deep rounded-[24px] border border-pixel/40 overflow-hidden max-w-xl h-full flex flex-col transition-colors duration-300 hover:border-primary">
  <a data-astro-prefetch href={`/blog/${slug}`} class="block aspect-4/3 overflow-hidden" tabindex="-1" aria-hidden="true">
    <Image
      transition:persist={`blog-image-${slug}`}
      src={thumb_image.image}
      alt=""
      loading="lazy"
      width={400}
      height={300}
      format="avif"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
  </a>
  <div class="p-6 space-y-4 flex-1 flex flex-col">
    <div class="flex flex-wrap gap-2">
      {
        tags.slice(0, 2).map((tag: string) => (
          <a
            data-astro-prefetch
            href={`/tags/${tag.toLowerCase()}`}
            class="inline-flex items-center px-3 py-1 text-[13px] leading-[18px] font-semibold bg-primary/15 hover:bg-primary text-primary hover:text-night rounded-full transition-colors">
            {tag[0].toUpperCase() + tag.slice(1)}
          </a>
        ))
      }
    </div>
    <a data-astro-prefetch href={`/blog/${slug}`} class="block flex-1 group/title">
      <h3 class="font-display text-[22px] leading-[26px] text-gray-900 line-clamp-3 transition-colors group-hover/title:text-primary">
        {title}
      </h3>
    </a>
    <time datetime={post.data.date.toISOString()} class="block text-[13px] leading-[18px] font-semibold text-mist/70">
      {post.data.date.toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" })}
    </time>
  </div>
</article>
