---
import MarkdownIt from "markdown-it";
const md = new MarkdownIt({ html: true });

// Define TypeScript interfaces
interface Props {
  title: string;
  description: string;
  badge?: string;
  badge_icon?: string;
  is_section?: boolean;
}

const { title, description, badge, badge_icon, is_section } = Astro.props;
---

<section class={`relative ${
  is_section
    ? "pt-12 pb-16 xl:pt-16 xl:pb-20 bg-linear-to-b from-white via-primary/5 to-primary/10"
    : "bg-primary/10 pt-28 pb-10 sm:pt-32 sm:pb-12 lg:pt-36 lg:pb-14"
}`}>
  {is_section && (
    <!-- Decorative Transition Divider -->
    <div class="max-w-4xl mx-auto px-4 mb-12 flex items-center justify-center">
      <div class="w-full border-t border-gray-200/80 relative">
        <div class="absolute left-1/2 -top-3.5 -translate-x-1/2 bg-white px-5 py-1 rounded-full border border-gray-200 shadow-xs text-xs font-bold uppercase tracking-wider text-gray-700 flex items-center gap-2">
          {badge_icon && <i class={`${badge_icon} text-primary text-base`} />}
          <span>{badge || "Section"}</span>
        </div>
      </div>
    </div>
  )}

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-center">
      <div class="w-full lg:w-2/3 text-center">
        <div class="relative pb-4">
          {!is_section && badge && (
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-primary/15 text-primary border border-primary/20 mb-6 shadow-xs">
              {badge_icon && <i class={`${badge_icon} text-sm`} />}
              <span>{badge}</span>
            </div>
          )}
          <h2 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold leading-tight mb-6 tracking-tight">
            <editable-text data-prop="title">{title}</editable-text>
          </h2>
          <div class="text-lg text-gray-600 leading-relaxed" data-editable="text" data-prop="description" set:html={md.render(description)} />
        </div>
      </div>
    </div>
  </div>
</section>

