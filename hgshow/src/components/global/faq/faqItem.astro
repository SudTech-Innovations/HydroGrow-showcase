---
import MarkdownIt from "markdown-it";
const md = new MarkdownIt({ html: true });

interface FaqItemProps {
  title: string;
  description: string;
}

interface Props {
  faq: FaqItemProps;
  i: number;
}

const { faq, i, ...rest } = Astro.props;
---

<details
  class="bg-deep rounded-[24px] border border-pixel/40 overflow-hidden group"
  {...rest}
>
  <summary
    class="w-full px-6 py-6 text-left flex items-center justify-between transition-colors duration-200 cursor-pointer list-none"
  >
    <div class="flex items-center space-x-4">
      <span
        class="shrink-0 w-8 h-8 bg-primary text-night rounded-full flex items-center justify-center text-sm font-bold"
      >
        0{i + 1}
      </span>
      <h3 class="text-xl font-normal text-mist leading-snug">
        <editable-text data-prop="title">{faq.title}</editable-text>
      </h3>
    </div>
    <svg
      class="w-5 h-5 shrink-0 ml-4 text-growth transition-transform duration-200 group-open:rotate-180"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 9l-7 7-7-7"></path>
    </svg>
  </summary>

  <div class="px-6 pb-7 pl-18 pr-12">
    <div
      class="text-mist/90 text-base leading-7 prose max-w-none"
      data-editable="text"
      data-prop="description"
      set:html={md.render(faq.description || "")}
    />
  </div>
</details>
