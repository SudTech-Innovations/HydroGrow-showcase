---
import MarkdownIt from "markdown-it";
import Heading from "@components/shared/Heading.astro";
import FaqItem from "./faqItem.astro";
import faqData from "@data/faqs.json";

const md = new MarkdownIt({ html: true });

// Define TypeScript interfaces
interface FaqItemData {
  title: string;
  description: string;
}

interface Props {
  title: string;
  title_suffix: string;
  description: string;
  FAQ?: FaqItemData[];
  faq_group?: keyof typeof faqData;
}

const { title_suffix, description, FAQ = [], faq_group, title } = Astro.props;

// Combine global FAQs with local FAQs
const globalFaqs = (faq_group && faqData[faq_group as keyof typeof faqData]) || [];
const finalFaqs = [...globalFaqs, ...FAQ];
---

<section class="py-16 xl:py-24 2xl:py-32 bg-deep/40">
  <div class="max-w-7xl mx-auto px-6 lg:px-14">
    <div class="flex justify-center">
      <div class="w-full lg:w-2/3 text-center">
        <div class="mb-12 xl:mb-16">
          <Heading level={2} class="mb-6 tracking-tight">
            {title}{" "}
            <span class="text-primary">
                {title_suffix}
            </span>
          </Heading>
          {
            description && (
              <div
                class="text-lg text-mist/80 leading-relaxed"
                set:html={md.render(description)}
              />
            )
          }
        </div>
      </div>
    </div>
    {
      finalFaqs?.length && (
        <div class="flex justify-center">
          <div class="w-full">
            <div
              class="space-y-4 grid gap-3"
            >
              {
                <template>
                  <FaqItem faq={{ title: "", description: "" }} i={0} />
                </template>
              }
              {finalFaqs?.map((q: FaqItemData, i: number) => (
                <FaqItem faq={q} i={i} />
              ))}
            </div>
          </div>
        </div>
      )
    }
  </div>
</section>
