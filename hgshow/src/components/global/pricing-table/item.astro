---
import Button from "../../shared/Button.astro";

// Define TypeScript interfaces
interface Feature {
  item: string;
  active_feature: boolean;
}

interface Button {
  link: string;
  text: string;
}

interface Props {
  tier: string;
  highlight_tier: boolean;
  description: string;
  currency_symbol?: string;
  price?: number | string;
  has_discount?: boolean;
  discount_price?: number | string;
  price_status?: string;
  features: Feature[];
  button?: Button;
}

const { tier, highlight_tier, description, currency_symbol, price, has_discount, discount_price, price_status, features, button } = Astro.props;
const hasPrice = price !== undefined && price !== null && price !== "";
---


<div class={`bg-deep rounded-[20px] border transition-all duration-300 ease-in-out p-8 xl:p-10 mb-8 lg:mb-14 h-full flex flex-col justify-between ${
  highlight_tier
    ? "border-primary lg:-mt-10"
    : "border-pixel/40 hover:border-pixel hover:-translate-y-1.5"
}`}>

  <!-- Card Header -->
  <div class="flex items-center justify-between gap-3 mb-2">
    <h3
      class={`text-2xl xl:text-3xl font-bold leading-tight transition-all duration-300 ${
      highlight_tier
        ? "text-primary"
        : "text-gray-900"
    }`}
    >
      {tier}
    </h3>
    {highlight_tier && (
      <span class="shrink-0 rounded-full border border-primary/50 px-3 py-1 text-xs font-semibold text-primary">
        Recommandé
      </span>
    )}
  </div>

  <p
    class="text-base xl:text-lg leading-relaxed mb-6 text-gray-600 font-medium min-h-[56px]">
    {description}
  </p>

  <!-- Pricing Section -->
  <div class="relative mb-8 flex items-center text-mist border-t border-b border-pixel/40 py-4">
    {hasPrice ? (
      has_discount ? (
        <>
          <!-- Discount Price Display -->
          <p class="text-4xl xl:text-5xl font-bold pl-4 xl:pl-6 mb-0 mr-4 z-10">
            {currency_symbol}
            {discount_price}
          </p>

          <!-- Original Price with Strikethrough -->
          <div class="relative flex items-center">
            <p class="text-2xl font-semibold text-gray-500 mb-0 relative z-10">
              {currency_symbol}
              {price}
            </p>
            <!-- Strikethrough Vector -->
            <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 z-20">
              <img
                src="/images/pricing/Vector1.svg"
                alt="Strikethrough"
                loading="lazy"
                class="w-auto h-auto"
              />
            </div>
          </div>
        </>
      ) : (
        <>
          <!-- Regular Price Display -->
          <p class="text-4xl xl:text-5xl font-bold pl-4 xl:pl-6 mb-0 z-10">
            <span>
              {currency_symbol}
              {price}
            </span>
          </p>
        </>
      )
    ) : (
      <div class="py-1">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-sm font-semibold bg-primary/15 text-primary border border-primary/30">
          <span class="inline-block w-2 h-2 rounded-full bg-primary"></span>
          {price_status || "Tarif en cours de réflexion"}
        </span>
      </div>
    )}
  </div>

  <!-- Features List & Action -->
  <div class="flex-1 flex flex-col justify-between">
      <ul class="space-y-4 mb-10 flex-1">
      {features?.length && features?.map((feature) => (
        <li
          class={`flex items-start text-base xl:text-lg leading-snug font-medium ${
            feature.active_feature
              ? "text-gray-600"
              : "text-mist/40"
          }`}
        >
          <i
            class={`mr-3 mt-1 shrink-0 ${
              feature.active_feature
                ? "ph-check text-primary"
                : "ph-minus text-mist/40"
            }`}
          />
          <span>
            {feature.item}
            {!feature.active_feature && <span class="sr-only"> (non inclus)</span>}
          </span>
        </li>
      ))}
    </ul>

    <!-- Action Button -->
    <div>
      {button && (
        <Button
          href={button.link}
          variant={highlight_tier ? "primary" : "secondary"}
          size="lg"
          class="w-full justify-center text-center"
          text={button.text}
        />
      )}
    </div>
  </div>
</div>

