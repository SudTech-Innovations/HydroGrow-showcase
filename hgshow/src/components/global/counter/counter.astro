---
import MarkdownIt from "markdown-it";
import AnimatedNumber from "../../shared/AnimatedNumber.tsx";
import Heading from "../../shared/Heading.astro";

const md = new MarkdownIt({ html: true });

// Receive all props from the content block
const { title, title_suffix, description, numbers, alternate_style } = Astro.props;

interface CounterNumber {
  prefix?: string;
  number: string;
  suffix?: string;
  text: string;
  // Liste affichée au survol de l'astérisque
  details?: { label: string; items: string[] }[];
}

export interface Props {
  title: string;
  title_suffix?: string;
  description: string;
  numbers: CounterNumber[];
  alternate_style?: boolean;
  _name?: string;
}
---

<section class={`${alternate_style ? "bg-deep pb-20 lg:pb-52" : ""}`} id="counter-up">
  <div class="w-full max-w-7xl mx-auto px-6 lg:px-14">
    <div class="flex flex-wrap">
      <div class="w-full">
        <div class="pt-12 pb-9 text-center">
          <Heading level={2} class="mb-6 text-mist">
            <span>{title}</span>{" "}
            <span class="text-primary">
              {title_suffix}
            </span>
          </Heading>
          <div class="w-full sm:w-4/5 xl:w-3/5 mx-auto text-base sm:text-lg [&_a]:underline [&_a]:underline-offset-4" set:html={md.render(description)} />
        </div>
      </div>
      <div class="w-full">
        {
          numbers && (
            <div
              class={`relative grid ${numbers.length === 3 ? "grid-cols-1 sm:grid-cols-3" : "grid-cols-2 lg:grid-cols-4"} gap-0 items-center justify-center text-center`}>
              {numbers.map((number: CounterNumber, i: number) => (
                <div class={number.details ? "group h-full" : "relative h-full"}>
                  <div
                    class={`pt-6 px-2 pb-4 2xl:pt-8 2xl:px-8 xl:pt-8 xl:px-4 xl:pb-7 sm:pt-8 sm:px-0 sm:pb-7`}>
                    <div class=" flex justify-center">
                      <span
                        class="text-4xl sm:text-5xl lg:text-6xl font-display text-primary leading-tight">
                        {number.prefix || ""}
                      </span>
                      <AnimatedNumber
                        numberValue={Number(number.number)}
                        className="text-4xl sm:text-5xl lg:text-6xl font-display text-primary leading-tight"
                        client:load
                      />
                      <span
                        class="text-4xl sm:text-5xl lg:text-6xl font-display text-primary leading-tight">
                        {number.suffix || ""}
                      </span>
                      {number.details && (
                        <button
                          type="button"
                          class="self-start cursor-help px-2 text-3xl font-display text-primary"
                          aria-label={`Voir la liste : ${number.text}`}
                          aria-describedby={`counter-details-${i}`}>
                          *
                        </button>
                      )}
                    </div>
                    <p class="text-gray-900 text-sm sm:text-base mb-0 sm:px-8 sm:pb-0">
                      {number.text}
                    </p>
                  </div>
                  {number.details && (
                    <div
                      id={`counter-details-${i}`}
                      role="tooltip"
                      class="invisible absolute left-0 right-0 top-full z-30 mx-auto max-w-3xl rounded-[20px] border border-pixel/50 bg-deep p-6 text-left opacity-0 shadow-2xl transition-all duration-200 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                      {number.details.map((group) => (
                        <Fragment>
                          <p class="mb-2 text-sm font-semibold text-primary">{group.label}</p>
                          <ul class="mb-4 columns-2 gap-6 text-sm leading-6 text-mist last:mb-0 sm:columns-3">
                            {group.items.map((item) => <li>{item}</li>)}
                          </ul>
                        </Fragment>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
