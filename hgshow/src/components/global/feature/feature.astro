---
import Button from "@components/shared/Button.astro";
import { Image } from "astro:assets";
import MarkdownIt from "markdown-it";
import Heading from "../../shared/Heading.astro";
import DotGrid from "../../shared/DotGrid.astro";
const md = new MarkdownIt({ html: true });

// Define TypeScript interfaces
interface Button {
  link: string;
  text: string;
}

interface Props {
  image: string;
  image_alt: string;
  title: string;
  description: string;
  button?: Button;
  reversed?: boolean;
  landscape?: boolean;
  stats?: { value: string; label: string }[];
}

const { image, image_alt, title, description, button, reversed, landscape, stats } = Astro.props;
---

<section class="py-16 sm:py-20 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-14">
    <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-12">
      <div class={`w-full lg:w-1/2 ${reversed ? 'order-1' : 'order-1 lg:order-2'}`}>
        <div class="card-image-wrapper img-float relative mb-7 sm:mb-8 lg:mb-10 2xl:mb-16 z-10">
          <div class="relative rounded-[28px]">
            <div class="relative z-10 overflow-hidden rounded-[28px] bg-gray-50 ring-1 ring-pixel/40">
              <Image
                class="w-full h-auto object-cover"
                src={image}
                alt={image_alt}
                loading="lazy"
                width={landscape ? 1600 : 696}
                height={landscape ? 893 : 752}
              />
            </div>
          </div>
          {stats && stats.length > 0 && (
            <!-- Carte de chiffres clés : Cal Sans, vert pousse, légendes en Inter 600 (charte v2, planches 12 et 15) -->
            <div class="absolute bottom-4 left-4 right-4 z-20 flex items-end gap-6 rounded-[20px] border border-pixel/40 bg-deep p-4 sm:bottom-4 sm:left-4 sm:right-4">
              {stats.map((s) => (
                <div class="min-w-0">
                  <div class="font-display text-[22px] leading-[26px] text-growth sm:text-[28px] sm:leading-[32px]">{s.value}</div>
                  <div class="text-[13px] leading-[18px] font-semibold text-mist/80">{s.label}</div>
                </div>
              ))}
              <svg viewBox="0 0 120 40" class="ml-auto hidden h-10 w-28 shrink-0 sm:block" aria-hidden="true" fill="none">
                <path d="M2 34 C 18 32, 24 34, 40 26 S 66 20, 80 14 S 106 8, 118 4" stroke="#5BE3A8" stroke-width="2" stroke-linecap="round" />
              </svg>
            </div>
          )}
          {/* Trame de points décorative */}
          <DotGrid
            variant="h"
            class={`absolute -z-10 w-24 sm:w-52 ${reversed ? "-bottom-8 -left-2 lg:-left-12" : "-top-8 -right-2 lg:-right-12"}`}
          />
        </div>
      </div>
      
      <div class={`w-full lg:w-1/2 ${reversed ? 'order-2' : 'order-2 lg:order-1'}`}>
        <div class={`mb-7 md:mb-10 xl:mb-16 relative z-20 ${reversed ? '2xl:ps-8' : '2xl:pe-8'}`}>
          <Heading level={2} text={title} class={"pb-6"} />
          <div class="mt-4 prose prose-slate max-w-none" set:html={md.render(description)} />
          {button && (
            <div class="mt-8">
              <Button href={button.link} variant={"link"} text={button.text} />
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
