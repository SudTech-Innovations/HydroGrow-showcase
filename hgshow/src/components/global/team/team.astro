---
import { Image } from "astro:assets";
import Heading from "../../shared/Heading.astro";

interface TeamMember {
  name: string;
  designation: string;
  image?: string;
  image_alt?: string;
}

interface Props {
  title: string;
  description?: string;
  badge?: string;
  team_members: TeamMember[];
}

const { title, description, badge, team_members } = Astro.props;
---

<section class="py-16 xl:py-24 2xl:py-32 border-t border-pixel/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl xl:max-w-3xl mx-auto mb-12 lg:mb-16">
      <div class="text-center">
        {badge && (
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-primary text-night mb-4">
            <i class="ph-users-three text-sm" />
            <span>{badge}</span>
          </div>
        )}
        <Heading level={2} text={title} data-prop="title" data-editable="text" class="mb-4" />
        {description && (
          <p class="text-lg text-gray-600 leading-relaxed max-w-2xl mx-auto" data-prop="description" data-editable="text">
            {description}
          </p>
        )}
      </div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6 lg:gap-4" data-editable="array" data-prop="team_members">
      {
        team_members?.map((member: TeamMember, i: number) => (
          <div data-editable="array-item" class="team-card img-float">
            <div class="text-center group bg-deep rounded-[24px] p-4 border border-pixel/40 hover:border-primary hover:-translate-y-1.5 transition-all duration-300 h-full flex flex-col justify-between">
              <div>
                <div class="mb-4 rounded-[14px] overflow-hidden">
                  {member.image ? (
                  <Image
                    data-editable="image"
                    data-prop-src="image"
                    data-prop-alt="image_alt"
                    src={member.image}
                    alt={member.image_alt}
                    loading="lazy"
                    width={516}
                    height={579}
                    class="w-full h-auto object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                  ) : (
                    <div
                      class="w-full aspect-[516/579] bg-night flex items-center justify-center text-5xl font-display text-primary"
                      aria-hidden="true"
                    >
                      {member.name.split(" ").map((w: string) => w[0]).join("").slice(0, 2).toUpperCase()}
                    </div>
                  )}
                </div>
                <div class="space-y-1">
                  <h3 class="text-lg font-display text-gray-900" data-editable="text" data-prop="name">
                    {member.name}
                  </h3>
                  <p class="inline-block rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-xs text-primary font-semibold" data-editable="text" data-prop="designation">
                    {member.designation}
                  </p>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
