---
import Button from "../../shared/Button.astro";
import companyData from "@data/company.json";

const company = companyData as any;

// Define TypeScript interfaces
interface ContactInfo {
  heading?: string;
  address?: string;
  cell?: string;
  email?: string;
  image?: string;
  image_alt?: string;
}

interface CreatorInfo {
  name?: string;
  role?: string;
  bio?: string;
  image?: string;
  image_alt?: string;
  email?: string;
  linkedin?: string;
  github?: string;
  phone?: string;
  availability?: string;
}

interface FormField {
  heading: string;
  placeholder: string;
}

interface SubmitButton {
  text: string;
}

interface ContactForm {
  heading: string;
  fullname: FormField;
  phone_number: FormField;
  email: FormField;
  message: FormField;
  submit_button: SubmitButton;
}

interface Props {
  address?: ContactInfo;
  phone?: ContactInfo;
  email?: ContactInfo;
  creator?: CreatorInfo;
  form?: ContactForm;
}

const { address, phone, email, creator, form } = Astro.props;

const fallbackAddress = company.address ? {
  heading: company.address_label || "Adresse",
  address: company.address,
  image: "/images/contact/corporate-fare.svg",
  image_alt: "Address icon"
} : undefined;

const fallbackPhone = company.phone ? {
  heading: company.phone_label || "Téléphone",
  cell: company.phone,
  image: "/images/contact/call-add.svg",
  image_alt: "Phone icon"
} : undefined;

const fallbackEmail = {
  heading: company.email_label || "Email direct",
  email: company.contact_email_address || "contact@hydrogrow.fr",
  image: "/images/contact/directbox-send.svg",
  image_alt: "Email icon"
};

const displayAddress = address?.address ? address : fallbackAddress;
const displayPhone = phone?.cell ? phone : fallbackPhone;
const displayEmail = email?.email ? email : (email?.heading ? { ...fallbackEmail, heading: email.heading } : fallbackEmail);

const defaultCreator: CreatorInfo = {
  name: "Nicolas V.",
  role: "Fondateur & Porteur du projet HydroGrow",
  bio: "Passionné par l'IoT, l'automatisation et l'agriculture urbaine connectée. Je développe HydroGrow pour rendre le suivi et le pilotage des cultures hydroponiques simples et précis, pour les professionnels d'abord.",
  image: "/images/team/nicolas.webp",
  image_alt: "Photo de Nicolas",
  email: company.contact_email_address || "contact@hydrogrow.fr",
  linkedin: "https://linkedin.com/in/votre-profil",
  github: "https://github.com/votre-compte",
  phone: "",
  availability: "Disponible pour échanger"
};

const currentCreator: CreatorInfo = creator ? { ...defaultCreator, ...creator } : defaultCreator;
---

{form ? (
  <section class="mb-20">
    <div class="bg-deep/40 lg:h-60 -z-30 relative"></div>
    <div class="max-w-7xl pt-10 mx-auto px-6 lg:px-14">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-16">
        <!-- Contact Information -->
        <div class="lg:col-span-5 order-1 lg:-mt-30">
          <div class="space-y-8">
            {displayAddress && (
              <div class="space-y-2">
                <h3 class="text-xl font-semibold text-gray-900">
                  {displayAddress.heading}
                </h3>
                <div class="flex items-start gap-2 text-gray-600 hover:text-gray-900 transition-colors">
                  <img
                    src={displayAddress.image || "/images/default-address.png"}
                    alt={displayAddress.image_alt || "Address icon"}
                    loading="lazy"
                    width="24"
                    height="24"
                    class="w-6 h-6 shrink-0 mt-0.5"
                  />
                  <div>
                    {displayAddress.address}
                  </div>
                </div>
              </div>
            )}
            
            {displayPhone && (
              <div class="space-y-2">
                <h3 class="text-xl font-semibold text-gray-900">
                  {displayPhone.heading}
                </h3>
                <a 
                  href={`tel:${displayPhone.cell}`}
                  class="inline-flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors"
                >
                  <img
                    src={displayPhone.image || "/images/default-phone.png"}
                    alt={displayPhone.image_alt || "Phone icon"}
                    loading="lazy"
                    width="24"
                    height="24"
                    class="w-6 h-6"
                  />
                  {displayPhone.cell}
                </a>
              </div>
            )}
            
            {displayEmail && (
              <div class="space-y-2">
                <h3 class="text-xl font-semibold text-gray-900">
                  {displayEmail.heading}
                </h3>
                <a 
                  href={`mailto:${displayEmail.email}`}
                  class="inline-flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors"
                >
                  <img
                    src={displayEmail.image || "/images/default-email.png"}
                    alt={displayEmail.image_alt || "Email icon"}
                    loading="lazy"
                    width="24"
                    height="24"
                    class="w-6 h-6"
                  />
                  {displayEmail.email}
                </a>
              </div>
            )}
          </div>
        </div>

        <!-- Contact Form -->
        <div class="lg:col-span-7 order-1 lg:order-2 lg:-mt-50">
          <div class="relative bg-deep rounded-[20px] p-8 shadow-lg border border-pixel/40">
            
            <form method="post" class="space-y-6">
              <h3 class="text-2xl font-bold text-gray-900 mb-8">
                {form.heading}
              </h3>
              
              {form.fullname && (
                <div class="space-y-2">
                  <label for="Name" class="block text-sm font-medium text-gray-700">
                    {form.fullname.heading}
                  </label>
                  <input 
                    type="text" 
                    class="w-full min-h-12 px-4 py-3 border border-gray-300 rounded-[14px] focus:ring-2 focus:ring-primary focus:border-primary transition-colors" 
                    id="Name" 
                    name="name" 
                    placeholder={form.fullname.placeholder} 
                    required 
                  />
                </div>
              )}

              {form.phone_number && (
                <div class="space-y-2">
                  <label for="phone-number" class="block text-sm font-medium text-gray-700">
                    {form.phone_number.heading}
                  </label>
                  <input
                    type="tel"
                    class="w-full min-h-12 px-4 py-3 border border-gray-300 rounded-[14px] focus:ring-2 focus:ring-primary focus:border-primary transition-colors"
                    id="phone-number"
                    name="phone-number"
                    placeholder={form.phone_number.placeholder}
                    required
                  />
                </div>
              )}

              {form.email && (
                <div class="space-y-2">
                  <label for="email" class="block text-sm font-medium text-gray-700">
                    {form.email.heading}
                  </label>
                  <input 
                    type="email" 
                    class="w-full min-h-12 px-4 py-3 border border-gray-300 rounded-[14px] focus:ring-2 focus:ring-primary focus:border-primary transition-colors" 
                    id="email" 
                    name="_replyto" 
                    placeholder={form.email.placeholder} 
                    required 
                  />
                </div>
              )}

              {form.message && (
                <div class="space-y-2">
                  <label for="message" class="block text-sm font-medium text-gray-700">
                    {form.message.heading}
                  </label>
                  <textarea
                    class="w-full min-h-12 px-4 py-3 border border-gray-300 rounded-[14px] focus:ring-2 focus:ring-primary focus:border-primary transition-colors resize-vertical"
                    id="floatingTextarea2"
                    name="message"
                    placeholder={form.message.placeholder}
                    rows="6"
                    spellcheck="false"
                  ></textarea>
                </div>
              )}

              <!-- Honeypot field -->
              <input type="text" name="_gotcha" class="hidden" />

              {form.submit_button && (
                <div class="pt-4">
                  <Button
                    type="submit"
                    variant="primary"
                    size="lg"
                    text={form.submit_button.text}
                    class="w-full sm:w-auto"
                  />
                </div>
              )}
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
) : (
  /* Direct Contact & Creator Showcase */
  <section class="mb-20">
    <div class="bg-deep/40 h-44 sm:h-52 lg:h-60 -z-30 relative"></div>
    <div class="max-w-5xl -mt-28 sm:-mt-36 lg:-mt-44 mx-auto px-6 lg:px-14">
      
      <!-- Creator Profile Card -->
      <div class="bg-deep rounded-[28px] p-8 sm:p-10 xl:p-12 shadow-xl border border-pixel/40 mb-10 transition-all duration-300 hover:shadow-2xl">
        <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
          
          <!-- Avatar -->
          <div class="relative shrink-0 text-center">
            <div class="w-32 h-32 sm:w-40 sm:h-40 rounded-[20px] overflow-hidden shadow-lg ring-4 ring-primary/20 bg-primary/10 mx-auto">
              <img
                src={currentCreator.image || "/images/team/nicolas.webp"}
                alt={currentCreator.image_alt || currentCreator.name || "Photo"}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            {currentCreator.availability && (
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-primary text-night mt-3">
                <span class="w-2 h-2 rounded-full bg-night"></span>
                {currentCreator.availability}
              </span>
            )}
          </div>

          <!-- Profile Details -->
          <div class="flex-1 text-center md:text-left space-y-4">
            <div>
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-primary/10 text-primary border border-primary/20 mb-2">
                <i class="ph-user text-sm" />
                <span>Porteur du projet</span>
              </div>
              <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight">
                {currentCreator.name}
              </h2>
              <p class="text-lg font-medium text-primary mt-1">
                {currentCreator.role}
              </p>
            </div>

            {currentCreator.bio && (
              <p class="text-gray-600 leading-relaxed text-base sm:text-lg">
                {currentCreator.bio}
              </p>
            )}

            <!-- Links & Action buttons -->
            <div class="pt-3 flex flex-wrap items-center justify-center md:justify-start gap-3">
              {currentCreator.email && (
                <a
                  href={`mailto:${currentCreator.email}`}
                  class="inline-flex items-center gap-2 px-5 py-2.5 rounded-[14px] font-bold text-sm bg-primary text-secondary hover:bg-primary/90 transition-all duration-200 shadow-sm"
                >
                  <i class="ph-envelope-simple text-lg" />
                  <span>M'écrire un e-mail</span>
                </a>
              )}
              {currentCreator.linkedin && (
                <a
                  href={currentCreator.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-5 py-2.5 rounded-[14px] font-bold text-sm bg-night hover:bg-deep text-mist border border-pixel/60 transition-all duration-200"
                >
                  <i class="ph-linkedin-logo text-lg text-primary" />
                  <span>LinkedIn</span>
                </a>
              )}
              {currentCreator.github && (
                <a
                  href={currentCreator.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-5 py-2.5 rounded-[14px] font-bold text-sm bg-night hover:bg-deep text-mist border border-pixel/60 transition-all duration-200"
                >
                  <i class="ph-github-logo text-lg text-gray-700" />
                  <span>GitHub</span>
                </a>
              )}
              {currentCreator.phone && (
                <a
                  href={`tel:${currentCreator.phone}`}
                  class="inline-flex items-center gap-2 px-5 py-2.5 rounded-[14px] font-bold text-sm bg-night hover:bg-deep text-mist border border-pixel/60 transition-all duration-200"
                >
                  <i class="ph-phone text-lg text-primary" />
                  <span>{currentCreator.phone}</span>
                </a>
              )}
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Contact Cards -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- Email Direct Card -->
        <div class="bg-deep rounded-[20px] p-6 shadow-md border border-pixel/40 hover:border-primary/40 transition-all duration-200 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="w-12 h-12 rounded-[14px] bg-night flex items-center justify-center text-primary text-2xl">
              <i class="ph-envelope-open" />
            </div>
            <h3 class="text-xl font-bold text-gray-900">Email Direct</h3>
            <p class="text-sm text-gray-500 leading-relaxed">
              Pour toute question générale, suggestion technique ou demande d'information.
            </p>
          </div>
          <div class="pt-6">
            <a
              href={`mailto:${currentCreator.email || displayEmail.email}`}
              class="inline-flex items-center gap-2 text-primary font-bold text-sm hover:underline"
            >
              <span>{currentCreator.email || displayEmail.email}</span>
              <i class="ph-arrow-right" />
            </a>
          </div>
        </div>

        <!-- Réseau & Échanges Card -->
        <div class="bg-deep rounded-[20px] p-6 shadow-md border border-pixel/40 hover:border-primary/40 transition-all duration-200 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="w-12 h-12 rounded-[14px] bg-night flex items-center justify-center text-primary text-2xl">
              <i class="ph-chats-circle" />
            </div>
            <h3 class="text-xl font-bold text-gray-900">Échanges & Réseau</h3>
            <p class="text-sm text-gray-500 leading-relaxed">
              Discuter d'opportunités, partager vos retours d'expérience en culture hydroponique ou tester les outils.
            </p>
          </div>
          <div class="pt-6">
            <a
              href={currentCreator.linkedin || "https://linkedin.com"}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-primary font-bold text-sm hover:underline"
            >
              <span>Rejoindre sur LinkedIn</span>
              <i class="ph-arrow-right" />
            </a>
          </div>
        </div>

        <!-- Développement & IoT Card -->
        <div class="bg-deep rounded-[20px] p-6 shadow-md border border-pixel/40 hover:border-primary/40 transition-all duration-200 flex flex-col justify-between sm:col-span-2 lg:col-span-1">
          <div class="space-y-3">
            <div class="w-12 h-12 rounded-[14px] bg-night flex items-center justify-center text-primary text-2xl">
              <i class="ph-code" />
            </div>
            <h3 class="text-xl font-bold text-gray-900">Projet & Code</h3>
            <p class="text-sm text-gray-500 leading-relaxed">
              Suivez le développement de l'écosystème, les intégrations IoT et les composants ouverts.
            </p>
          </div>
          <div class="pt-6">
            <a
              href={currentCreator.github || "https://github.com"}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-primary font-bold text-sm hover:underline"
            >
              <span>Voir le profil GitHub</span>
              <i class="ph-arrow-right" />
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>
)}
