---
import { Image } from "astro:assets";
import Button from "../../shared/Button.astro";
import Heading from "../../shared/Heading.astro";
import Text from "../../shared/Text.astro";
import Rings from "../../shared/Rings.astro";
import DotGrid from "../../shared/DotGrid.astro";

// Define TypeScript interfaces
interface ButtonType {
  link: string;
  text: string;
}

interface HeroImage {
  image: string;
  image_alt: string;
  placement?: "front_bottom" | "back_top_right" | "back_top_left";
}

interface Props {
  title: string;
  description: string;
  tagline?: string;
  button?: ButtonType;
  // Single image props (for backward compatibility)
  image?: string;
  image_alt?: string;
  // Multiple images props (for about page and similar)
  hero_images?: HeroImage[];
}


const { title, description, tagline, button, image, image_alt, hero_images } = Astro.props;

// Helper function to get placement class
const getPlacementClass = (placement: string) => {
  switch (placement) {
    case "front_bottom":
      return "col-[2_/_4] row-[2_/_4] z-10";
    case "back_top_right":
      return "col-[3_/_-1] row-[1_/_3] ";
    case "back_top_left":
      return "col-[1_/_3] row-[1_/_2] mt-10";
    default:
      return "";
  }
};

// Check if we're using multiple images or single image
const hasMultipleImages = hero_images && hero_images.length > 0;
const hasSingleImage = image && image_alt;
---


<section class="relative isolate pt-24 bg-night overflow-hidden">
  <!-- Cercles concentriques : le signal qui se propage -->
  <Rings class="absolute -z-10 -top-40 -right-56 w-[820px] h-[820px] max-w-none" />
  <!-- Trame de points -->
  {!hasMultipleImages && <DotGrid variant="field" cols={12} rows={6} class="hidden lg:block absolute -z-10 left-8 bottom-10 w-[420px] opacity-80" />}

  <div class="mx-auto max-w-[1500px] px-6 pt-10 pb-24 sm:pb-32 lg:flex lg:px-8 lg:py-40">
    <div class="mx-auto max-w-2xl shrink-0 lg:mx-0 lg:pt-8">
      <Heading level={1} text={title} data-prop="title" data-editable="text" class="mb-6 hero-in" style="--d:100ms" />
      <Text text={description} data-prop="description" data-editable="text" size="xl" markdown={true} class="text-pretty hero-in" style="--d:260ms" />
      {tagline && (
        <p class="mt-6 inline-block rounded-full bg-growth px-4 py-1.5 text-[13px] leading-[18px] font-semibold text-night hero-in" style="--d:340ms" data-prop="tagline" data-editable="text">{tagline}</p>
      )}
      <div class="mt-10 flex items-center gap-x-6 hero-in" style="--d:420ms">
        {button && <Button href={button.link} variant={"primary"} size={"lg"} text={button.text} data-prop="button.text" data-editable="text" />}
      </div>
    </div>
    
    <!-- Image Section -->
    <div class={`${hasMultipleImages ? "" : "hero-in hero-in-img"} mx-auto mt-16 grid max-w-2xl sm:mt-24 lg:mt-0 lg:mr-0 lg:ml-10 lg:max-w-none lg:flex-none xl:ml-32`}>
      {hasMultipleImages ? (
        <!-- Multiple Images Layout (About Page Style) -->
        <div class="grid grid-cols-[1fr_1fr_1fr_2fr] gap-5 max-w-3xl" data-editable="array" data-prop="hero_images">
          {hero_images.map((heroImage, i) => (
            <div 
              class={`${getPlacementClass(heroImage.placement || "")} hero-pic hero-pic-${heroImage.placement || "default"}`}
              data-editable="array-item"
            >
              <div class="relative w-full h-full">
                {
                  heroImage?.image && (
                    <Image
                      data-editable="image"
                      data-prop-src="image"
                      data-prop-alt="image_alt"
                      src={heroImage.image}
                      alt={heroImage.image_alt || ""}
                      width={600}
                      height={400}
                      fetchpriority={i === 0 ? 'high' : undefined}
                      class="w-full h-full object-cover rounded-[36px] bg-deep shadow-xl ring-1 ring-pixel/50"
                      loading="eager"
                      decoding="async"
                    />
                  )
                }
              </div>
            </div>
          ))}
          <DotGrid variant="h" class="absolute -z-10 bottom-0 -left-6 w-40 hidden sm:block" />
        </div>
      ) : hasSingleImage ? (
        <!-- Single Image Layout (Original Style) -->
        <div class="max-w-3xl flex-none sm:max-w-5xl lg:max-w-none img-float img-float-lg">
          <Image
            data-editable="image"
            data-prop-src="image"
            data-prop-alt="image_alt"
            src={image}
            alt={image_alt || ""}
            width={1028}
            height={600}
            loading={"eager"}
            fetchpriority="high"
            class="max-h-[600px] w-full object-cover rounded-[36px] bg-deep shadow-xl ring-1 ring-pixel/50"
          />
        </div>
      ) : null}
    </div>
  </div>
</section>
