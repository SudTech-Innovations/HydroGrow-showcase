---
import BlogList from "@components/blog/list.astro";
import BlogPagination from "@components/blog/pagination.astro";
import Layout from "@layouts/Layout.astro";
import tagGroups from "@data/blog-tag-groups.json";
import type { Page } from "astro";
import { getCollection, getEntry, type CollectionEntry } from "astro:content";

export async function getStaticPaths({ paginate }: { paginate: Function }) {
  const tags: Record<string, any> = {};
  const page = await getEntry("pages", "blog");
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  posts.forEach(({ data }) => data.tags.forEach((tag: string) => (tags[tag] = true)));

  return Object.keys(tags).flatMap((tag) => {
    const filteredPosts = posts.filter(({ data }) => data.tags.includes(tag));
    return paginate(filteredPosts, {
      params: { tag },
      pageSize: page?.data.page_size,
    });
  });
}

interface Props {
  page: Page;
  posts: CollectionEntry<"blog">[];
}

const tag = Astro.params.tag ?? "";
const blogPage = (await getEntry("pages", "blog"))?.data;

if (!blogPage) {
  throw new Error(`Failed to find blog index page info for tag: ${tag}`);
}

// Catégorie du mot-clé, affichée au-dessus du titre (« Autres sujets » si non classé)
const category = (tagGroups as { label: string; tags: string[] }[]).find((g) => g.tags.includes(tag))?.label ?? "Autres sujets";

// Copie : ne jamais modifier l'entrée de contenu, elle est partagée (et mise en cache) avec /blog/
const page = {
  ...blogPage,
  title: tag[0].toUpperCase() + tag.slice(1),
  description: "",
};

const pagination = Astro.props.page;
const filteredPosts = pagination.data;
---

<Layout title={`Blog : ${page.title}`} seo={page.seo} noindex>
  <BlogList posts={filteredPosts} page={page} badge={category} />
  <BlogPagination pagination={pagination} />
</Layout>
