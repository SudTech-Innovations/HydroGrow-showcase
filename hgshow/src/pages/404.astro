---
import Button from "@components/shared/Button.astro";
import DotGrid from "@components/shared/DotGrid.astro";
import Rings from "@components/shared/Rings.astro";
import Layout from "@layouts/Layout.astro";
---

<Layout title="Page non trouvée" noindex>
  <section class="relative isolate flex min-h-[calc(100svh-4rem)] items-center justify-center overflow-hidden px-6 py-32">
    <!-- Trames de points aux quatre coins -->
    <DotGrid variant="h" cols={4} rows={5} class="absolute -z-10 left-6 top-28 w-24 sm:w-36 lg:left-14" />
    <DotGrid variant="h" cols={4} rows={5} class="absolute -z-10 right-6 top-28 w-24 sm:w-36 lg:right-14" />
    <DotGrid variant="field" cols={4} rows={5} class="absolute -z-10 left-6 bottom-12 w-24 sm:w-36 opacity-80 lg:left-14" />
    <DotGrid variant="field" cols={4} rows={5} class="absolute -z-10 right-6 bottom-12 w-24 sm:w-36 opacity-80 lg:right-14" />

    <div class="relative flex flex-col items-center text-center">
      <div class="relative">
        <!-- Cercles concentriques, point vert au centre du « 0 » -->
        <div class="absolute -z-10 left-1/2 top-1/2 h-0 w-0">
          <Rings rings={5} class="absolute left-0 top-0 w-[560px] max-w-none -ml-[280px] -mt-[280px] sm:w-[740px] sm:-ml-[370px] sm:-mt-[370px]" />
        </div>
        <h1 class="font-display text-[112px] leading-none tracking-tight text-mist sm:text-[200px]">404</h1>
      </div>
      <p class="mt-8 text-[22px] leading-[26px] font-display text-mist sm:text-[32px] sm:leading-[36px]">Page non trouvée</p>
      <p class="mt-3 max-w-md text-base text-mist/80">Cette page n'existe pas ou a été déplacée. Retournez à l'accueil pour continuer.</p>
      <Button href="/" class="mt-8">Retour à l'accueil</Button>
    </div>
  </section>
</Layout>
