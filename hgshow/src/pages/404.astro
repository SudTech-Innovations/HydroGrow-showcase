---
import Button from "@components/shared/Button.astro";
import Heading from "@components/shared/Heading.astro";
import Layout from "@layouts/Layout.astro";
---

<Layout title="404 Not Found">
  <section class="grid place-items-center px-6 pt-30">
    <img src="/images/404/error.webp" alt="Erreur 404 : cette page n'existe pas" width="1600" height="893" class="w-full max-w-xl rounded-[28px]" />
    <Heading level={2} text="Page non trouvée" class="p-4" />
    <Button href="/" class="m-6">Retour à l'accueil</Button>
  </section>
</Layout>
