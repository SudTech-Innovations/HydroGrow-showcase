---
import "../styles/global.css";
import { getCollection } from "astro:content";
import { SEO } from "astro-seo";
import Analytics from '@vercel/analytics/astro'
import Footer from "@components/layouts/footer.astro";
import SignupModal from "@components/shared/SignupModal.astro";
import Navigation from "@components/layouts/navigation";
import site from "@data/site.json";
import company from "@data/company.json";

export interface SEOProps {
  page_description: string | null;
  featured_image: string | null;
  featured_image_alt: string | null;
  canonical_url: string | null;
  no_index: boolean | null;
  open_graph_type: string | null;
  author_twitter_handle: string | null;
}

export interface Props {
  title: string;
  seo?: SEOProps;
  // Exclut la page des moteurs de recherche (404, pagination, pages de mots-clés)
  noindex?: boolean;
  // Données structurées supplémentaires (ex. Article)
  jsonLd?: Record<string, unknown>;
}

const { seo, noindex, jsonLd } = Astro.props;
const baseUrl = Astro.site;
const isHome = Astro.url.pathname === "/";
// Accueil : titre riche en mots-clés plutôt que « Accueil | HydroGrow »
const title = isHome
  ? site.home_title
  : Astro.props.title
    ? `${Astro.props.title} | ${site.site_title}`
    : site.site_title;
const description = seo?.page_description || site.description;
// Les balises Open Graph exigent des URL absolues
const image = new URL(seo?.featured_image || site.image, baseUrl).toString();
const image_alt = seo?.featured_image_alt || site.image_alt;
const canonicalURL = new URL(seo?.canonical_url || Astro.url.pathname, baseUrl);
const graph: Record<string, unknown>[] = [
  {
    "@type": "Organization",
    "@id": new URL("/#organization", baseUrl).toString(),
    name: site.site_title,
    url: baseUrl?.toString(),
    logo: new URL("/images/logo-icon.svg", baseUrl).toString(),
    email: "contact@hydrogrow.fr",
    // Profils officiels : aident les moteurs à rattacher les réseaux au site
    sameAs: [company.instagram_url].filter(Boolean),
  },
  {
    "@type": "WebSite",
    "@id": new URL("/#website", baseUrl).toString(),
    url: baseUrl?.toString(),
    name: site.site_title,
    description: site.description,
    inLanguage: "fr-FR",
    publisher: { "@id": new URL("/#organization", baseUrl).toString() },
  },
];
if (jsonLd) graph.push(jsonLd);
const structuredData = JSON.stringify({ "@context": "https://schema.org", "@graph": graph });
const blogTags = [...new Set((await getCollection("blog", ({ data }) => !data.draft)).flatMap(({ data }) => data.tags))]
  .sort((a, b) => a.localeCompare(b, "fr"));
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="alternate" type="application/rss+xml" title="HydroGrow : blog" href="/feed.xml" />
    <link rel="icon" href="/favicon.ico?v=3" sizes="48x48" />
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <link rel="icon" href="/images/favicon.png?v=3" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>document.documentElement.classList.add("js");</script>

    <SEO
      noindex={noindex || seo?.no_index || false}
      title={title}
      description={description}
      canonical={canonicalURL.toString()}
      openGraph={{
        basic: {
          title: isHome ? "HydroGrow : l'avenir est local" : Astro.props.title,
          url: canonicalURL.toString(),
          type: `${seo?.open_graph_type || "website"}`,
          image: image,
        },
        optional: {
          description: description,
          siteName: site.site_title,
        },
        image: {
          url: image,
          alt: image_alt,
        },
      }}
      twitter={{
        creator: `${seo?.author_twitter_handle || site.twitter_site}`,
        site: `${site.twitter_site}`,
        card: "summary_large_image",
      }}
    />
    <script type="application/ld+json" set:html={structuredData} is:inline />
    <!-- Icônes : traits arrondis, un seul ton (charte v2, planche 13) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Cal+Sans&display=swap" />
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css" />
    <script is:inline>
      // Le balisage utilise `ph-xxx` seul ; Phosphor v2 exige aussi la classe `ph`.
      document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll('[class^="ph-"], [class*=" ph-"]').forEach(function (el) {
          el.classList.add("ph");
        });
      });
    </script>
    <Analytics />
  </head>
  <body class="min-h-screen flex flex-col bg-night text-mist">
    
      <Navigation client:load pageUrl={canonicalURL} blogTags={blogTags} />
    
    <div class="flex-1">
      <slot />
    </div>
    <Footer />
    <SignupModal />

    <script is:inline>
      // Apparition progressive au scroll (désactivée si "réduire les animations")
      (function () {
        // Variante de flottement par image (rythme/sens différents)
        document.querySelectorAll(".img-float").forEach(function (el, i) { el.dataset.fv = String(i % 3); });
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduce || !("IntersectionObserver" in window)) {
          document.querySelectorAll(".dg, .rings").forEach(function (el) { el.classList.add("is-visible"); });
          return;
        }
        var targets = document.querySelectorAll(
          "main h2, section h2, section details, #counter-up .grid > div, .card-image-wrapper, article, .team-card"
        );
        targets.forEach(function (el, i) {
          if (el.closest("header")) return;
          // Un bloc plus haut que l'écran (texte d'un article) n'atteindrait pas toujours le seuil et resterait invisible
          if (el.offsetHeight > window.innerHeight) return;
          el.classList.add("reveal");
        });
        var io = new IntersectionObserver(function (entries) {
          // Décalage par lot, dans l'ordre d'affichage, plafonné (évite qu'un élément tardif passe avant les autres)
          var k = 0;
          entries
            .filter(function (e) { return e.isIntersecting; })
            .sort(function (a, b) { return a.boundingClientRect.top - b.boundingClientRect.top; })
            .forEach(function (e) {
              if (e.target.classList.contains("reveal")) e.target.style.setProperty("--d", Math.min(k++, 5) * 90 + "ms");
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            });
        }, { threshold: 0.12, rootMargin: "0px 0px -6% 0px" });
        document.querySelectorAll(".reveal, .dg, .rings").forEach(function (el) { io.observe(el); });

        // Parallaxe douce : les décors dérivent légèrement plus lentement que la page
        var deco = Array.prototype.slice.call(document.querySelectorAll(".dg, .rings"));
        var ticking = false;
        function update() {
          var vh = window.innerHeight;
          // Révèle d'office ce qui a été dépassé par un saut de scroll (ancre, retour de page…)
          document.querySelectorAll(".reveal:not(.is-visible)").forEach(function (el) {
            if (el.getBoundingClientRect().bottom < 0) { el.style.setProperty("--d", "0ms"); el.classList.add("is-visible"); io.unobserve(el); }
          });
          deco.forEach(function (el) {
            var r = el.getBoundingClientRect();
            if (r.bottom < -200 || r.top > vh + 200) return;
            var offset = (r.top + r.height / 2 - vh / 2) * -0.12;
            el.style.setProperty("--py", Math.max(-60, Math.min(60, offset)).toFixed(1) + "px");
          });
          ticking = false;
        }
        window.addEventListener("scroll", function () {
          if (!ticking) { ticking = true; requestAnimationFrame(update); }
        }, { passive: true });
        update();
      })();
    </script>
  </body>
</html>
