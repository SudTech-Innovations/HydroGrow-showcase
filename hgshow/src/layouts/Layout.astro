---
import "../styles/global.css";
import { getCollection } from "astro:content";
import { SEO } from "astro-seo";
import Analytics from '@vercel/analytics/astro'
import Footer from "@components/layouts/footer.astro";
import Navigation from "@components/layouts/navigation";
import site from "@data/site.json";
import ThemeEditableWrapper from "@components/shared/ThemeEditableWrapper";

export interface SEOProps {
  page_description: string | null;
  featured_image: string | null;
  featured_image_alt: string | null;
  canonical_url: string | null;
  no_index: boolean | null;
  open_graph_type: string | null;
  author_twitter_handle: string | null;
}

export interface Props {
  title: string;
  seo?: SEOProps;
}

const { seo } = Astro.props;
const baseUrl = Astro.site;
const title = Astro.props.title ? `${Astro.props.title} | ${site.site_title}` : site.site_title;
const description = seo?.page_description || site.description;
const image = seo?.featured_image || site.image;
const image_alt = seo?.featured_image_alt || site.image_alt;
const canonicalURL = new URL(seo?.canonical_url || Astro.url.pathname, baseUrl);
const blogTags = [...new Set((await getCollection("blog", ({ data }) => !data.draft)).flatMap(({ data }) => data.tags))]
  .sort((a, b) => a.localeCompare(b, "fr"));
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/images/favicon.ico?v=1" sizes="any" type="image/x-icon" />
    <link rel="shortcut icon" href="/images/favicon.ico?v=1" type="image/x-icon" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>document.documentElement.classList.add("js");</script>

    <SEO
      noindex={seo?.no_index || false}
      title={title}
      description={description}
      canonical={canonicalURL.toString()}
      openGraph={{
        basic: {
          title: Astro.props.title,
          url: baseUrl?.toString(),
          type: `${seo?.open_graph_type || "website"}`,
          image: image,
        },
        optional: {
          description: description,
        },
        image: {
          url: image,
          alt: image_alt,
        },
      }}
      twitter={{
        creator: `${seo?.author_twitter_handle || site.twitter_site}`,
        site: `${site.twitter_site}`,
        card: "summary_large_image",
      }}
    />
    <!-- Icônes : traits arrondis, un seul ton (charte planche 09) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Cal+Sans&display=swap" />
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css" />
    <script is:inline>
      // Le balisage utilise `ph-xxx` seul ; Phosphor v2 exige aussi la classe `ph`.
      document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll('[class^="ph-"], [class*=" ph-"]').forEach(function (el) {
          el.classList.add("ph");
        });
      });
    </script>
    <Analytics />
  </head>
  <body class="min-h-screen flex flex-col bg-night text-mist">
    <script>
      // Lazy load CloudCannon component registration only when in editor mode
      if (window?.inEditorMode) {
        import("../scripts/register-components.ts").catch((error) => {
          console.warn("Failed to load CloudCannon component registration:", error);
        });
      }
    </script>
    <editable-component data-component="layouts/Navigation" data-prop="@data[navigation]">
      <Navigation client:load pageUrl={canonicalURL} blogTags={blogTags} />
    </editable-component>
    <div class="flex-1">
      <slot />
    </div>
    <Footer />

    <ThemeEditableWrapper client:only="react" />
    <script is:inline>
      // Apparition progressive au scroll (désactivée en mode éditeur et si "réduire les animations")
      (function () {
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (window.inEditorMode || reduce || !("IntersectionObserver" in window)) {
          document.querySelectorAll(".dg, .rings").forEach(function (el) { el.classList.add("is-visible"); });
          return;
        }
        var targets = document.querySelectorAll(
          "main h2, section h2, section details, #counter-up .grid > div, .card-image-wrapper, article"
        );
        targets.forEach(function (el, i) {
          if (el.closest("header")) return;
          el.classList.add("reveal");
          var idx = Array.prototype.indexOf.call(el.parentNode.children, el);
          el.style.setProperty("--d", (idx % 6) * 90 + "ms");
        });
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add("is-visible"); io.unobserve(e.target); }
          });
        }, { threshold: 0.12, rootMargin: "0px 0px -6% 0px" });
        document.querySelectorAll(".reveal, .dg, .rings").forEach(function (el) { io.observe(el); });

        // Parallaxe douce : les décors dérivent légèrement plus lentement que la page
        var deco = Array.prototype.slice.call(document.querySelectorAll(".dg, .rings"));
        var ticking = false;
        function update() {
          var vh = window.innerHeight;
          deco.forEach(function (el) {
            var r = el.getBoundingClientRect();
            if (r.bottom < -200 || r.top > vh + 200) return;
            var offset = (r.top + r.height / 2 - vh / 2) * -0.12;
            el.style.setProperty("--py", Math.max(-60, Math.min(60, offset)).toFixed(1) + "px");
          });
          ticking = false;
        }
        window.addEventListener("scroll", function () {
          if (!ticking) { ticking = true; requestAnimationFrame(update); }
        }, { passive: true });
        update();
      })();
    </script>
  </body>
</html>
