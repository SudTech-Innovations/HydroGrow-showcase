---
import PostSummary from "@components/blog/summary.astro";
import Heading from "@components/shared/Heading.astro";
import Layout, { type SEOProps } from "@layouts/Layout.astro";
import type { MarkdownLayoutProps } from "astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

type Props =
  | {
      title: string;
      date: Date;
      updated?: Date | null;
      featured_image: {
        image: string;
        image_alt: string;
      };
      author: string;
      seo?: SEOProps;
      body: string;
      slug?: string;
    }
  | MarkdownLayoutProps<{
      title: string;
      date: Date;
      updated?: Date | null;
      featured_image: {
        image: string;
        image_alt: string;
      };
      author: string;
      seo?: SEOProps;
    }>;

const props = "frontmatter" in Astro.props ? Astro.props.frontmatter : Astro.props;
const { title, date, featured_image, author } = props;
// Date de mise à jour : prise en compte seulement si elle est postérieure à la publication
const updated = props.updated && new Date(props.updated) > new Date(date) ? new Date(props.updated) : null;
const formatDate = (value: Date) => value.toLocaleDateString("fr-FR", { year: "numeric", month: "long", day: "numeric" });
const content = "body" in Astro.props ? Astro.props.body : (Astro.props.rawContent() ?? "");
// Mots lus par le visiteur : sans les adresses des liens ni les signes de mise en forme
const wordCount = content
  .replace(/\]\([^)]*\)/g, "]")
  .split(/\s+/)
  .filter((word) => /[\p{L}\p{N}]/u.test(word)).length;
const readingTime = Math.max(1, Math.round(wordCount / 183));

// Articles liés (maillage interne) : mots-clés communs, les plus rares comptant davantage, puis les plus récents
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const currentSlug = "slug" in props ? props.slug : undefined;
const currentTags = allPosts.find((p) => p.slug === currentSlug)?.data.tags ?? [];
const tagCount = (tag: string) => allPosts.filter((p) => p.data.tags.includes(tag)).length;
const score = (tags: string[]) => tags.filter((t) => currentTags.includes(t)).reduce((sum, t) => sum + 1 / tagCount(t), 0);
const relatedPosts = allPosts
  .filter((p) => p.slug !== currentSlug)
  .sort((a, b) => score(b.data.tags) - score(a.data.tags) || b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// L'image de couverture de l'article sert aussi d'aperçu de partage (Open Graph)
const seo = {
  ...(props.seo ?? {}),
  page_description: props.seo?.page_description ?? null,
  featured_image: featured_image?.image ?? props.seo?.featured_image ?? null,
  featured_image_alt: featured_image?.image_alt ?? props.seo?.featured_image_alt ?? null,
  open_graph_type: "article",
} as SEOProps;
const siteUrl = Astro.site;
const articleUrl = new URL(Astro.url.pathname, siteUrl).toString();
const jsonLd = {
  "@type": "BlogPosting",
  headline: title,
  description: seo.page_description,
  image: featured_image?.image ? new URL(featured_image.image, siteUrl).toString() : undefined,
  datePublished: new Date(date).toISOString(),
  dateModified: new Date(updated ?? date).toISOString(),
  inLanguage: "fr-FR",
  author: { "@type": "Person", name: author },
  publisher: { "@id": new URL("/#organization", siteUrl).toString() },
  mainEntityOfPage: articleUrl,
};
---

<Layout title={title} seo={seo} jsonLd={jsonLd}>
  <section class="relative pt-36 pb-16 2xl:pt-48 xl:pt-40 sm:pt-32">
    <div class="max-w-7xl mx-auto px-6 lg:px-14">
      <div class="w-full">
        <article class="relative">
          <div class="sm:text-center sm:mb-12 mb-6">
            <Heading
              level={1}
              size={2}
              text={title}
              data-editable="text"
              data-prop="title"
              label="title"
              class="font-semibold font-sora text-gray-800 mb-6 2xl:w-3/5 xl:w-4/5 w-full mx-auto"
            />
            <div class="mb-8">
              <ul class="flex flex-wrap justify-center sm:justify-center gap-6 text-gray-600 font-semibold text-base">
                <li class="flex items-center">
                  <p class="mb-0 text-primary">
                    <time datetime={new Date(date).toISOString()}>{formatDate(date)}</time>
                  </p>
                </li>
                {
                  updated && (
                    <li class="relative pl-2 ml-5 flex items-center before:absolute before:content-[''] before:bg-gray-400 before:w-0.5 before:h-4 before:-left-3.5 before:top-1/2 before:-translate-y-1/2">
                      <p class="mb-0 text-primary">
                        Mis à jour le <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
                      </p>
                    </li>
                  )
                }
                <li
                  class="relative pl-2 ml-5 flex items-center before:absolute before:content-[''] before:bg-gray-400 before:w-0.5 before:h-4 before:-left-3.5 before:top-1/2 before:-translate-y-1/2">
                  <p class="mb-0 text-primary">
                    <editable-text data-prop="author">{author}</editable-text>
                  </p>
                </li>
                <li
                  class="relative pl-2 ml-5 flex items-center before:absolute before:content-[''] before:bg-gray-400 before:w-0.5 before:h-4 before:-left-3.5 before:top-1/2 before:-translate-y-1/2">
                  <p class="mb-0 text-primary">{readingTime} <span>min de lecture</span></p>
                </li>
                <li
                  class="relative pl-2 ml-5 flex items-center before:absolute before:content-[''] before:bg-gray-400 before:w-0.5 before:h-4 before:-left-3.5 before:top-1/2 before:-translate-y-1/2">
                  <p class="mb-0 text-primary">{wordCount} <span>mots</span></p>
                </li>
              </ul>
            </div>
          </div>
          {
            featured_image.image && (
              <div class=" mb-16 xl:mb-12 overflow-hidden">
                <div class="max-w-[1200px] max-h-96  lg:max-h-[666px] w-full h-[666px]">
                  <Image
                    data-editable="image"
                    data-prop-src="featured_image.image"
                    data-prop-alt="featured_image.image_alt"
                    width={1200}
                    height={666}
                    src={featured_image.image}
                    class="w-full h-full  max-w-full max-h-full object-cover rounded-[20px]"
                    alt={featured_image.image_alt}
                  />
                </div>
              </div>
            )
          }
          <div class="max-w-4xl mx-auto prose lg:prose-xl">
            <editable-text data-prop="@content">
              <slot />
            </editable-text>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="relative py-28 xl:py-20 lg:py-12 bg-deep">
    <div class="max-w-7xl mx-auto px-6 lg:px-14">
      <div class="w-full">
        <div class="mb-12">
          <Heading level={2} size={2} class="font-semibold font-sora text-gray-800"> À lire aussi </Heading>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {relatedPosts.map((post) => <PostSummary post={post} />)}
      </div>
    </div>
  </section>
</Layout>
